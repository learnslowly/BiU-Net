#!/bin/bash
#SBATCH --output=./eval/hla.out
#SBATCH --mem-per-cpu=8GB
#SBATCH --time=0-23:30:00
#SBATCH --job-name=hla
#SBATCH --partition=gpu2
#SBATCH --nodes=2
#SBATCH --ntasks=4
#SBATCH --cpus-per-task=8

source configs/credentials.sh
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8

# Define random states
RANDOM_STATES=(0 42 1024)

starttime=`date +'%Y-%m-%d %H:%M:%S'`

for state in "${RANDOM_STATES[@]}"; do
    echo "Running with random state: $state"
    
    # Build the command with conditional beagle test parameter
    CMD="python test.py --configFile configs/exp2/HLA_chr6_ALL_seg128_overlap8.yaml --randState $state"
    # Execute the command
    eval $CMD
done
    
endtime=`date +'%Y-%m-%d %H:%M:%S'`
start_seconds=$(date --date="$starttime" +%s)
end_seconds=$(date --date="$endtime" +%s)
total_seconds=$((end_seconds - start_seconds))
hours=$((total_seconds / 3600))
minutes=$(((total_seconds % 3600) / 60))
echo "Running time: ${hours}h ${minutes}m"
