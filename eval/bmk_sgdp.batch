#!/bin/bash
#SBATCH --output=archive/exp1/SGDP_chr22_ALL_seg-1_overlap0/eval/bmk_LONI_Mar05_1745_%a.log
#SBATCH --time=0-23:30:00
#SBATCH --job-name=bmk_1kg
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --array=0-11
#SBATCH --exclusive

# Define random states
RANDOM_STATES=(0 42 1024)
# Config file
CONFIG_FILE="archive/exp1/SGDP_chr22_ALL_seg-1_overlap0/LONI_Mar05_1745.yaml"
# Get number of missing levels
NUM_MISSING_LEVELS=$(python -c "
from config.modelconfig import ModelConfig
config = ModelConfig.from_yaml('$CONFIG_FILE')
print(len(config.missing))
")
# Calculate indices for this array task
RAND_IDX=$((SLURM_ARRAY_TASK_ID / NUM_MISSING_LEVELS))
MISS_IDX=$((SLURM_ARRAY_TASK_ID % NUM_MISSING_LEVELS))
RANDOM_STATE=${RANDOM_STATES[$RAND_IDX]}

# LOG_DIR=$(python -c " from config.modelconfig import ModelConfig config =
# ModelConfig.from_yaml('$CONFIG_FILE') print(config.analysisDir) ") mkdir -p $LOG_DIR
LOG_DIR="archive/exp1/SGDP_chr22_ALL_seg-1_overlap0"

# Create descriptive log file names
LOG_FILE="${LOG_DIR}/benchmark_rand${RANDOM_STATE}_missidx${MISS_IDX}.log"

source configs/credentials.sh
starttime=`date +'%Y-%m-%d %H:%M:%S'`

echo "Array task $SLURM_ARRAY_TASK_ID running with random state: $RANDOM_STATE"
# Run the command with output redirected to custom log file
python -u benchmark.py --configFile $CONFIG_FILE --randState $RANDOM_STATE --missingLevelIdx $MISS_IDX > $LOG_FILE 2>&1

endtime=`date +'%Y-%m-%d %H:%M:%S'`
start_seconds=$(date --date="$starttime" +%s)
end_seconds=$(date --date="$endtime" +%s)
total_seconds=$((end_seconds - start_seconds))
hours=$((total_seconds / 3600))
minutes=$(((total_seconds % 3600) / 60))
echo "Running time: ${hours}h ${minutes}m"

