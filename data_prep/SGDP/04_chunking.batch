#!/bin/bash

#SBATCH --output=./chunked/chunking.out
#SBATCH --mem-per-cpu=10GB
#SBATCH --time=2-23:00:00
#SBATCH --job-name=chunk
#SBATCH --partition=workq
#SBATCH --nodes=10
#SBATCH --ntasks=10
#SBATCH --cpus-per-task=20

# Activate the environment
source configs/credentials.sh
# Ensure no thread oversubscription (optional, but helpful for Python)
export OMP_NUM_THREADS=1  # Prevent NumPy/Pandas from using extra threads
unset SLURM_TRES_PER_TASK

# Run the Python script using srun
starttime=`date +'%Y-%m-%d %H:%M:%S'`
srun python chunking.py
endtime=`date +'%Y-%m-%d %H:%M:%S'`

# Report timing

start_seconds=$(date --date="$starttime" +%s)
end_seconds=$(date --date="$endtime" +%s)
total_seconds=$((end_seconds - start_seconds))
hours=$((total_seconds / 3600))
minutes=$(((total_seconds % 3600) / 60))
echo "Running time: ${hours}h ${minutes}m"
