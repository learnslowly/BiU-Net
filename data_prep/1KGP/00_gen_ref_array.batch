#!/bin/bash
#SBATCH --partition=workq
#SBATCH --time=4:00:00
#SBATCH --cpus-per-task=8
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --array=1-5,7-21        # Skip 6 and 22
#SBATCH --job-name=gen_ref
#SBATCH --output=logs/gen_ref_chr%a.out

# Get chromosome from array task ID
CHR=$SLURM_ARRAY_TASK_ID

# Add local bin to PATH
export PATH=$HOME/local/bin:$PATH
export LD_LIBRARY_PATH=$HOME/local/lib:$LD_LIBRARY_PATH
export BCFTOOLS_PLUGINS=$HOME/local/bin

set -euo pipefail

THREADS=$SLURM_CPUS_PER_TASK

# Create temp directory
if [ -n "${TMPDIR:-}" ]; then
    TMP_DIR=$(mktemp -d "$TMPDIR/ref_prep_chr${CHR}_XXXXXX")
else
    TMP_DIR=$(mktemp -d)
fi

# Check file creation function
check_file() {
    if [ ! -f "$1" ]; then
        echo "Error: Failed to create $1"
        exit 1
    fi
}

echo "Processing chromosome $CHR using $THREADS threads..."
mkdir -p ref

# 1.
echo "Step 1: Removing duplicate variants for chr$CHR"
bcftools norm -d all -Oz -o "$TMP_DIR/non_dup_chr${CHR}_ALL.vcf.gz" \
    orig/GRCh38/ALL.chr${CHR}.shapeit2_integrated_snvindels_v2a_27022019.GRCh38.phased.vcf.gz
check_file "$TMP_DIR/non_dup_chr${CHR}_ALL.vcf.gz"

# 2.
echo "Step 2: Filtering for biallelic SNPs for chr$CHR"
bcftools view --min-alleles 2 --max-alleles 2 -v snps -Oz \
    -o "$TMP_DIR/biallelic_non_dup_chr${CHR}_ALL.vcf.gz" \
    "$TMP_DIR/non_dup_chr${CHR}_ALL.vcf.gz"
check_file "$TMP_DIR/biallelic_non_dup_chr${CHR}_ALL.vcf.gz"

# 3.
echo "Step 3: Normalizing variants for chr$CHR"
bcftools norm -m -any -Oz \
    -o "$TMP_DIR/1KGP_chr${CHR}_ALL_ref.vcf.gz" \
    "$TMP_DIR/biallelic_non_dup_chr${CHR}_ALL.vcf.gz"
check_file "$TMP_DIR/1KGP_chr${CHR}_ALL_ref.vcf.gz"

# Index the file
tabix -p vcf "$TMP_DIR/1KGP_chr${CHR}_ALL_ref.vcf.gz"

# Move final files to ref directory
mv "$TMP_DIR"/1KGP_chr${CHR}_ALL_ref.vcf.gz{,.tbi} ref/

# Clean up intermediate files
rm -f "$TMP_DIR/non_dup_chr${CHR}_ALL.vcf.gz"
rm -f "$TMP_DIR/biallelic_non_dup_chr${CHR}_ALL.vcf.gz"

echo "Chromosome $CHR processing completed"
rm -rf "$TMP_DIR"
