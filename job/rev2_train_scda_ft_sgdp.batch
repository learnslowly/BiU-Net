#!/bin/bash
#SBATCH --output=logs/rev2_train_scda_ft_sgdp_%j.log
#SBATCH --open-mode=append
#SBATCH --time=3-00:00:00
#SBATCH --job-name=rev2_scda_ft
#SBATCH --partition=gpu4
#SBATCH --nodes=4
#SBATCH --ntasks=16
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=12
#SBATCH --gpus-per-task=1

# Experiment-2 SCDA finetune: prebaked from the Exp-1 scda_fl_g22 checkpoint.
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=1
export MASTER_ADDR=$(scontrol show hostname $SLURM_NODELIST | head -n 1)
export MASTER_PORT=12391
export NCCL_DEBUG=WARN
export NCCL_IB_DISABLE=0
export NCCL_SOCKET_IFNAME=^lo
export TRITON_CACHE_DIR=/tmp/$USER/triton_cache_$SLURM_JOB_ID
export TORCHINDUCTOR_CACHE_DIR=/tmp/$USER/inductor_cache_$SLURM_JOB_ID
mkdir -p $TRITON_CACHE_DIR $TORCHINDUCTOR_CACHE_DIR
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

DST_CKPT="checkpoints/checkpoint_scda_fl_ft_sgdp_SGDP_chr22_ALL_seg-1_overlap0_epoch_0.pth"
if ! ls checkpoints/checkpoint_scda_fl_ft_sgdp_*_epoch_*.pth >/dev/null 2>&1; then
  # Numeric epochs only: the run used trainOnVal, so epoch_best must not win
  # the version sort.
  SRC_CKPT=$(ls -v checkpoints/checkpoint_scda_fl_g22_*_epoch_[0-9]*.pth 2>/dev/null | tail -1)
  [ -n "$SRC_CKPT" ] || { echo "ERROR: no Exp-1 scda_fl_g22 checkpoint found"; exit 1; }
  echo "Prebaking $DST_CKPT from $SRC_CKPT (weights only, epoch reset to 0)"
  "$PYBIN" - "$SRC_CKPT" "$DST_CKPT" <<'EOF'
import sys, torch
src, dst = sys.argv[1], sys.argv[2]
ck = torch.load(src, map_location='cpu', weights_only=False)
ck['epoch'] = 0
ck.pop('optimizer', None)
ck.pop('scheduler', None)
torch.save(ck, dst)
print(f"prebaked: {dst}")
EOF
fi
CONFIG_FILE="configs/train_SGDP_g22_ALL_seg-1_scda_ft.yaml"

echo "Job $SLURM_JOB_ID started at $(date) on $SLURM_JOB_NODELIST"
srun --export=ALL --gpu-bind=closest "$PYBIN" -u train.py --configFile $CONFIG_FILE
RC=$?
echo "Job $SLURM_JOB_ID finished at $(date) (srun rc=$RC)"
exit $RC
