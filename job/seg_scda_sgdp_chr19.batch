#!/bin/bash
#SBATCH --output=./logs/seg_scda_sgdp_chr19_%j.log
#SBATCH --time=1-00:00:00
#SBATCH --job-name=seg_scda_sgdp19
#SBATCH --partition=workq
#SBATCH --nodes=4
#SBATCH --ntasks=4

source configs/credentials.sh
export OMP_NUM_THREADS=1
export HDF5_USE_FILE_LOCKING=FALSE
unset SLURM_TRES_PER_TASK

# Absolute env interpreter -- conda activate is unreliable in batch jobs here.
CONF=configs/SGDP_chr19_ALL_seg-1_overlap0.yaml

# --createFilteredSNPs False is REQUIRED for segLen=-1 (per-MAF filtered HDF5 are only
# meaningful/affordable for the segmented pipeline).
echo "Start: $(date)"
srun "${PYBIN}" -u segmenting.py --configFile ${CONF} --createFilteredSNPs False
echo "End:   $(date)"
