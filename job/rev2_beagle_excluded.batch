#!/bin/bash
#SBATCH --job-name=rev2_beagle_excl
#SBATCH --output=logs/%x_%j.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=0
#SBATCH --time=08:00:00

# Why Beagle scores fewer SNPs than the target contains: reproduces its Marker.equals()
# test against the reference panel and splits the dropped markers into panel-absent
# (cohort-private variants) and allele-mismatch (representation differences), by MAF
# bin.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE

echo "start $(date)"
# All 22 autosomes of both datasets: the exclusion rate is quoted as a property of each
# dataset, so it has to be measured across the genome rather than generalised from two
# chromosomes.
"$PYBIN" -u scripts/beagle_excluded_markers.py SGDP $(seq 1 22)
RC1=$?
"$PYBIN" -u scripts/beagle_excluded_markers.py 1KGP $(seq 1 22)
RC2=$?
[ $RC1 -ne 0 ] && exit $RC1
echo "finished $(date) (rc=$RC2)"
exit $RC2
