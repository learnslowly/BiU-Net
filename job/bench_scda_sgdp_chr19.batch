#!/bin/bash
#SBATCH --partition=workq
#SBATCH --job-name=bench_scda_sgdp19
#SBATCH --output=logs/bench_scda_sgdp_chr19_%j.log
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=04:00:00

cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export OMP_NUM_THREADS=8
export HDF5_USE_FILE_LOCKING=FALSE

CFG=configs/test_scda_SGDP_chr19_ALL.yaml

# SCDA (ref-free): NO --impMethod -> reads config.imputed_csv_gzs (test.py output).
for RS in 0 42 1024; do
  for IDX in 0 1 2; do
    echo "===== SCDA benchmark: randState=${RS}  missingLevelIdx=${IDX} ====="
    "${PYBIN}" -u benchmark.py \
      --configFile "${CFG}" \
      --randState "${RS}" \
      --missingLevelIdx "${IDX}"
  done
done
echo "All 9 SCDA benchmarks done -> analysis/"
