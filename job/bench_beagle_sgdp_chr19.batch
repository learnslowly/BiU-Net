#!/bin/bash
#SBATCH --partition=workq
#SBATCH --job-name=bench_bgl_sgdp19
#SBATCH --output=logs/bench_beagle_sgdp_chr19_%j.log
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=04:00:00

cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export OMP_NUM_THREADS=8
export HDF5_USE_FILE_LOCKING=FALSE

# Absolute env interpreter (conda activate is unreliable in batch jobs here).
CFG=configs/test_v3low_seg128_SGDP_chr19_ALL.yaml

# Original manuscript metric: phased 4-class, benchmarkAll=True (BAT), POOLED r2
# (perVariantR2=False in the config).
for RS in 0 42 1024; do
  for IDX in 0 1 2; do
    echo "===== Beagle benchmark: randState=${RS}  missingLevelIdx=${IDX} ====="
    "${PYBIN}" -u benchmark.py \
      --configFile "${CFG}" \
      --randState "${RS}" \
      --missingLevelIdx "${IDX}" \
      --impMethod beagle
  done
done
echo "All 12 Beagle benchmarks done -> analysis/"
