#!/bin/bash
#SBATCH --output=logs/train_ft50_%j.log
#SBATCH --time=2-00:00:00
#SBATCH --job-name=train_ft50
#SBATCH --partition=gpu4
#SBATCH --nodes=4
#SBATCH --ntasks=16
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=12
#SBATCH --gpus-per-task=1
#SBATCH --gres=gpu:4

# Colwise <=50% finetune of v3_low_seg128 (warm-start from epoch_200 seed).

source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export MASTER_ADDR=$(scontrol show hostname $SLURM_NODELIST | head -n 1)
export MASTER_PORT=12432
export NCCL_DEBUG=WARN
export NCCL_IB_DISABLE=0
export NCCL_SOCKET_IFNAME=^lo
export TRITON_CACHE_DIR=/tmp/$USER/triton_cache
mkdir -p $TRITON_CACHE_DIR

cd "${SLURM_SUBMIT_DIR:-.}"
echo "Job $SLURM_JOB_ID (train_ft50) started at $(date)"
srun --export=ALL --gpu-bind=closest python -u train.py \
    --configFile configs/train_LOS_chr22_ALL_seg128_v3low_ft50.yaml
echo "Job $SLURM_JOB_ID (train_ft50) finished at $(date)"
