#!/bin/bash
#SBATCH --job-name=seg_HLA_chr6_ALL
#SBATCH --output=logs/%x_%j.log
#SBATCH --open-mode=append
#SBATCH --partition=workq
#SBATCH --nodes=4
#SBATCH --ntasks=4
#SBATCH --cpus-per-task=8
#SBATCH --mem-per-cpu=10GB
#SBATCH --time=1-00:00:00

# Project root + central credentials (REMOTE_*, PYBIN, MASTER_PORT, NCCL_*, etc.).
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=1
unset SLURM_TRES_PER_TASK

# Segment into seg HDF5.
echo "Start: $(date)"
srun "$PYBIN" -u segmenting.py --configFile configs/HLA_chr6_ALL_seg128_overlap64.yaml --createFilteredSNPs False
echo "End:   $(date)"
