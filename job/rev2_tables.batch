#!/bin/bash
#SBATCH --job-name=rev2_tables
#SBATCH --output=logs/%x_%j.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=01:00:00

# Revision-2 final step: aggregate analysis/ benchmark cells into the per-chromosome +
# genome-wide summary tables (Results/*_revision2.csv).
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
DS="${1:-1KGP}"
"$PYBIN" -u scripts/build_rev2_tables.py "$DS"
RC=$?
echo "DONE (rc=$RC)"
exit $RC
