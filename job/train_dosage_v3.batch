#!/bin/bash
#SBATCH --output=logs/train_dosage_v3_%j.log
#SBATCH --time=3-00:00:00
#SBATCH --job-name=dosage_v3
#SBATCH --partition=gpu2
#SBATCH --nodes=12
#SBATCH --ntasks=24
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --gpus-per-task=1

# v3 production: full-22 with A2-winner config (lambda=0.1, dynamicRatio=True).

source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE

export MASTER_ADDR=$(scontrol show hostname $SLURM_NODELIST | head -n 1)
export MASTER_PORT=12349
export NCCL_DEBUG=WARN
export NCCL_IB_DISABLE=0
export NCCL_SOCKET_IFNAME=^lo
export TRITON_CACHE_DIR=/tmp/$USER/triton_cache
mkdir -p $TRITON_CACHE_DIR

CONFIG_FILE="configs/train_1KGP_chr1_22_ALL_seg1024_dosage_v3.yaml"

starttime=$(date +'%Y-%m-%d %H:%M:%S')
echo "Job $SLURM_JOB_ID started at $starttime on $SLURM_JOB_NODELIST"
echo "Master: $MASTER_ADDR:$MASTER_PORT  WORLD_SIZE=$SLURM_NTASKS"

srun --export=ALL --gpu-bind=closest python -u train.py --configFile $CONFIG_FILE

endtime=$(date +'%Y-%m-%d %H:%M:%S')
echo "Job $SLURM_JOB_ID finished at $endtime"
