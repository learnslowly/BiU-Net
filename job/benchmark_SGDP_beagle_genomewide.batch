#!/bin/bash
#SBATCH --job-name=benchmark_SGDP_beagle_genomewide
#SBATCH --output=logs/%x_%j.log
#SBATCH --open-mode=append
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00

# Project root + central credentials (REMOTE_*, PYBIN, MASTER_PORT, NCCL_*, etc.).
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=8
unset SLURM_TRES_PER_TASK

# Beagle is scored on the markers it matched against its panel, one chromosome at a
# time, from its own configs.
for C in $(seq 1 22); do
  CFG=configs/test_beagle_SGDP_genomewide_chr$C.yaml
  echo "===== chromosome $C ====="
  "$PYBIN" -u benchmark.py --configFile "$CFG" --impMethod beagle
done
echo "benchmark SGDP beagle done -> analysis/"
