#!/bin/bash
#SBATCH --job-name=rev2_chrft_eval
#SBATCH --output=logs/%x_%A_%a.log
#SBATCH --partition=gpu2
#SBATCH --nodes=1
#SBATCH --ntasks=2
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=12
#SBATCH --gres=gpu:2
#SBATCH --time=04:00:00
#SBATCH --array=0-21

# Imputes and scores one chromosome with its fine-tuned model. Usage: sbatch
# job/rev2_eval_chrft.batch {1KGP|SGDP}
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
DS="${1:-}"
[ -n "$DS" ] || { echo "usage: sbatch job/rev2_eval_chrft.batch 1KGP|SGDP"; exit 2; }
C=$((SLURM_ARRAY_TASK_ID + 1))

export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=1
export MPLBACKEND=Agg
export MASTER_ADDR=$(scontrol show hostname "$SLURM_JOB_NODELIST" | head -n 1)
export MASTER_PORT=$((13100 + SLURM_ARRAY_TASK_ID))
export NCCL_SOCKET_IFNAME=^lo
unset SLURM_TRES_PER_TASK

CFG="configs/test_${DS}_chrft_${C}.yaml"
[ -s "$CFG" ] || { echo "ERROR: missing config $CFG"; exit 1; }

echo "eval $DS chr$C start $(date)"
srun --export=ALL --gpu-bind=closest "$PYBIN" -u test.py --configFile "$CFG"
RC=$?
[ $RC -ne 0 ] && { echo "test.py failed (rc=$RC)"; exit $RC; }

FAIL=0
for RS in 0 42 1024; do
  for IDX in 0 1 2; do
    "$PYBIN" -u benchmark.py --configFile "$CFG" --randState "$RS" --missingLevelIdx "$IDX" \
      || { echo "FAILED rand=$RS idx=$IDX"; FAIL=1; }
  done
done
echo "eval $DS chr$C finished $(date) (fail=$FAIL)"
exit $FAIL
