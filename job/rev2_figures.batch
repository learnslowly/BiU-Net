#!/bin/bash
#SBATCH --job-name=rev2_figures
#SBATCH --output=logs/%x_%j.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export MPLBACKEND=Agg
"$PYBIN" -u scripts/build_rev2_maf_profile.py
"$PYBIN" -u scripts/build_rev2_per_chromosome.py
"$PYBIN" -u scripts/build_rev2_excluded_figure.py
