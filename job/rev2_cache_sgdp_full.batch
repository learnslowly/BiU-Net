#!/bin/bash
#SBATCH --output=logs/rev2_cache_sgdp_full_%A_%a.log
#SBATCH --time=02:00:00
#SBATCH --job-name=rev2_cache_sgdp
#SBATCH --partition=workq
#SBATCH --array=1-22
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G

# Prebuild .compact.npz sidecars for everything the ft_sgdp_full run (987900) preloads:
# SGDP own train/val plus the ALLPANEL aligned reference files that job 987899 segments.

cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
C=$SLURM_ARRAY_TASK_ID

echo "chr$C cache build started $(date)"
"$PYBIN" -u scripts/build_compact_cache.py \
    "res/SGDP_chr${C}_ALL_train_chunk*_seg1024_overlap128.hdf5" \
    "res/SGDP_chr${C}_ALL_val_chunk*_seg1024_overlap128.hdf5" \
    "res/SGDP_chr${C}_ALLPANEL_train_chunk*_seg1024_overlap128.hdf5"
RC=$?
echo "chr$C cache build finished $(date) (rc=$RC)"
exit $RC
