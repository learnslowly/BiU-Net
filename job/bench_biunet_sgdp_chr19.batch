#!/bin/bash
#SBATCH --partition=workq
#SBATCH --job-name=bench_biu_sgdp19
#SBATCH --output=logs/bench_biunet_sgdp_chr19_%j.log
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=04:00:00

cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export OMP_NUM_THREADS=8
export HDF5_USE_FILE_LOCKING=FALSE

# Absolute env interpreter (conda activate is unreliable in batch jobs here).
CFG=configs/test_v3low_seg128_SGDP_chr19_ALL.yaml

# BiUNet (ref-free): NO --impMethod -> reads config.imputed_csv_gzs (the test.py
# output).
for RS in 0 42 1024; do
  for IDX in 0 1 2; do
    echo "===== BiUNet benchmark: randState=${RS}  missingLevelIdx=${IDX} ====="
    "${PYBIN}" -u benchmark.py \
      --configFile "${CFG}" \
      --randState "${RS}" \
      --missingLevelIdx "${IDX}"
  done
done
echo "All 9 BiUNet benchmarks done -> analysis/"
