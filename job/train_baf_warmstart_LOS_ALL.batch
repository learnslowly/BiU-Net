#!/bin/bash
#SBATCH --output=logs/train_baf_warmstart_LOS_ALL_%j.log
#SBATCH --time=12:00:00
#SBATCH --job-name=baf_ws_LOS
#SBATCH --partition=gpu4
#SBATCH --nodes=4
#SBATCH --ntasks=16
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=12
#SBATCH --gpus-per-task=1
#SBATCH --gres=gpu:4

# BAF-ALIGNED training (warm-start, fast read): SPORADIC masking + benchmarkAll=False =>
# loss ONLY on masked positions (the actual imputation task), not observed
# reconstruction.

source configs/credentials.sh
cd "${SLURM_SUBMIT_DIR:-.}"

cat > configs/train_LOS_chr22_ALL_seg128_baf.yaml <<'YAML'
runId: v3_low_seg128_baf
dataset: LOS
chromosome: 22
chromosomes: [22]
segLen: 128
overlap: 16
population: ALL
model: unet
bioAware: True
depth: 6
nchannels: 48
kernelSize: 7
stride: 1
dropoutRate: 0.05
useGroupNorm: False
batchSize: 256
learningRate: 0.00005
loss: hybridFocalLoss
dosageLossLambda: 0.1
focalAlpha: 0.25
focalGamma: 2.0
sampling: normal
missingRatio: 0.25
dynamicRatio: True
bertStrategy: False
maskMode: sporadic
preloadData: True
benchmarkAll: False
mixedPrecisionTraining: True
useTorchCompile: True
torchCompileMode: reduce-overhead
saveCheckpointFreq: 5
valFreq: 10
valSubsetFraction: 0.5
useWandB: False
finetuning: False
totalEpochs: 80
warmupEpochs: 0
cooldownEpochs: 0
scheduler: cosineAnn
adamwBeta1: 0.9
adamwBeta2: 0.99
adamwEps: 0.00000001
adamwWeightDecay: 0.01
seed: 42
earlyStoppingPatience: 15
earlyStoppingMinDelta: 0.0001
curriculumStartRatio: 0.05
curriculumWarmupEpochs: 30
bins: [0.001, 0.005, 0.010, 0.100, 0.200, 0.300, 0.400, 0.500]
batchSizeTest: 8
epoch: 0
YAML
echo "wrote config; $(date)"

python - <<'EOF'
import torch, os
BASE="checkpoints/checkpoint_v3_low_seg128_LOS_chr22_ALL_seg128_overlap16_epoch_best.pth"
OUT ="checkpoints/checkpoint_v3_low_seg128_baf_LOS_chr22_ALL_seg128_overlap16_epoch_0.pth"
if os.path.exists(OUT): print("seed exists, skipping")
else:
    assert os.path.isfile(BASE), f"missing base: {BASE}"
    ck=torch.load(BASE,map_location="cpu",weights_only=False)
    sd=ck["state_dict"] if isinstance(ck,dict) and "state_dict" in ck else ck
    sd={(k[len("_orig_mod."):] if k.startswith("_orig_mod.") else k):v for k,v in sd.items()}
    torch.save({"state_dict":sd,"epoch":0},OUT); print("wrote warm-start seed:",OUT,len(sd),"tensors")
EOF

export HDF5_USE_FILE_LOCKING=FALSE
export MASTER_ADDR=$(scontrol show hostname $SLURM_NODELIST | head -n 1)
export MASTER_PORT=12440
export NCCL_DEBUG=WARN
export NCCL_IB_DISABLE=0
export NCCL_SOCKET_IFNAME=^lo
export TRITON_CACHE_DIR=/tmp/$USER/triton_cache
mkdir -p $TRITON_CACHE_DIR

echo "Job $SLURM_JOB_ID (baf warm-start) training started $(date)"
srun --export=ALL --gpu-bind=closest python -u train.py \
    --configFile configs/train_LOS_chr22_ALL_seg128_baf.yaml
echo "finished $(date)"
