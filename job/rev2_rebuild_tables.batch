#!/bin/bash
#SBATCH --job-name=rev2_rebuild_tables
#SBATCH --output=logs/%x_%j.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=04:00:00

# Regenerates the derived tables after the full-axis rescore.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export MPLBACKEND=Agg

FAIL=0
"$PYBIN" -u scripts/build_rev2_probes.py || FAIL=1
"$PYBIN" -u scripts/build_rev2_vs_manuscript.py || FAIL=1
"$PYBIN" -u scripts/build_rev2_chrft.py || FAIL=1
echo "tables rebuilt $(date) (fail=$FAIL)"
exit $FAIL
