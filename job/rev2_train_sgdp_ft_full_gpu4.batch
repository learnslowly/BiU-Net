#!/bin/bash
#SBATCH --output=logs/rev2_train_sgdp_ft_full_g4_%j.log
#SBATCH --open-mode=append
#SBATCH --time=1-12:00:00
#SBATCH --job-name=rev2_sgdp_ftfull4
#SBATCH --partition=gpu4
#SBATCH --nodes=4
#SBATCH --ntasks=16
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=12
#SBATCH --gpus-per-task=1

# Revision-2 SGDP finetune: warm-start from the genome-wide 1KGP model.

cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=1

export MASTER_ADDR=$(scontrol show hostname $SLURM_NODELIST | head -n 1)
export MASTER_PORT=12389
export NCCL_DEBUG=WARN
export NCCL_IB_DISABLE=0
export NCCL_SOCKET_IFNAME=^lo
export TRITON_CACHE_DIR=/tmp/$USER/triton_cache_$SLURM_JOB_ID
export TORCHINDUCTOR_CACHE_DIR=/tmp/$USER/inductor_cache_$SLURM_JOB_ID
mkdir -p $TRITON_CACHE_DIR $TORCHINDUCTOR_CACHE_DIR

CONFIG_FILE="configs/train_SGDP_g22_ALL_seg1024_ft_full.yaml"
# SRC_EPOCH pins the warm start to the checkpoint the paper reports, rather than
# whatever is newest on disk: the 1KGP run plateaued at epoch 70 and later checkpoints
# score no better, so the finetune starts from the same weights.
if [ -n "${SRC_EPOCH:-}" ]; then
  SRC_CKPT="checkpoints/checkpoint_v3low_ref_g22_1KGP_chr22_ALL_seg1024_overlap128_epoch_${SRC_EPOCH}.pth"
else
  SRC_CKPT=$(ls -v checkpoints/checkpoint_v3low_ref_g22_1KGP_chr22_ALL_seg1024_overlap128_epoch_[0-9]*.pth 2>/dev/null | tail -1)
fi
DST_CKPT="checkpoints/checkpoint_ft_sgdp_full_SGDP_chr22_ALL_seg1024_overlap128_epoch_0.pth"

if ! ls checkpoints/checkpoint_ft_sgdp_full_*_epoch_*.pth >/dev/null 2>&1; then
  if [ -z "$SRC_CKPT" ] || [ ! -s "$SRC_CKPT" ]; then
    echo "ERROR: no numeric v3low_ref_g22 checkpoint to warm-start from"; exit 1
  fi
  echo "Warm-starting from $SRC_CKPT"
  echo "Prebaking $DST_CKPT from $SRC_CKPT (weights only, epoch reset to 0)"
  "$PYBIN" - "$SRC_CKPT" "$DST_CKPT" <<'EOF'
import sys, torch
src, dst = sys.argv[1], sys.argv[2]
ck = torch.load(src, map_location='cpu', weights_only=False)
ck['epoch'] = 0
ck.pop('optimizer', None)
ck.pop('scheduler', None)
torch.save(ck, dst)
print(f"prebaked: {dst}")
EOF
fi

echo "Job $SLURM_JOB_ID started at $(date) on $SLURM_JOB_NODELIST"
# 16 ranks instead of 24: gpu4 is far less contended for this account.
srun --export=ALL "$PYBIN" -u train.py --configFile $CONFIG_FILE --batchSize 384
RC=$?
echo "Job $SLURM_JOB_ID finished at $(date) (srun rc=$RC)"
exit $RC
