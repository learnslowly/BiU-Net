#!/bin/bash
#SBATCH --job-name=finetune_SGDP_anchor_chr19
#SBATCH --output=logs/%x_%j.log
#SBATCH --open-mode=append
#SBATCH --partition=gpu4
#SBATCH --nodes=1
#SBATCH --ntasks=4
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=16
#SBATCH --gres=gpu:4
#SBATCH --time=1-00:00:00

# Project root + central credentials (REMOTE_*, PYBIN, MASTER_PORT, NCCL_*, etc.).
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=1
unset SLURM_TRES_PER_TASK

export MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)
# MASTER_PORT, NCCL_SOCKET_IFNAME come from credentials.sh; CUDA_VISIBLE_DEVICES is
# pinned in the .py.

# The chromosome the original submission reports for this dataset, fine-tuned from the
# genome-wide checkpoint.
"$PYBIN" -u scripts/prebake_finetune_checkpoint.py configs/train_SGDP_genomewide.yaml configs/train_SGDP_finetuned_anchor_chr19.yaml
srun --gpu-bind=closest "$PYBIN" -u train.py --configFile configs/train_SGDP_finetuned_anchor_chr19.yaml
srun --gpu-bind=closest "$PYBIN" -u test.py  --configFile configs/test_SGDP_finetuned_anchor_chr19.yaml
"$PYBIN" -u benchmark.py --configFile configs/test_SGDP_finetuned_anchor_chr19.yaml
echo "End:   $(date)"
