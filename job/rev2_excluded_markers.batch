#!/bin/bash
#SBATCH --job-name=rev2_excluded
#SBATCH --output=logs/%x_%j.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=1-00:00:00

# What is recoverable at the markers a reference-based imputer cannot call? Beagle
# produces no output at target markers absent from its panel, so the head-to-head
# tables, which score every method on the intersection, are silent about that part of
# the target.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export MPLBACKEND=Agg

FAIL=0
for C in $(seq 1 22); do
  CFG="configs/test_SGDP_chrft_${C}.yaml"
  [ -s "$CFG" ] || { echo "missing $CFG"; FAIL=1; continue; }
  for RS in 0 42 1024; do
    for IDX in 0 1 2; do
      "$PYBIN" -u benchmark.py --configFile "$CFG" --randState "$RS" \
          --missingLevelIdx "$IDX" --excludedOnly \
        || { echo "FAILED chr$C rand$RS idx$IDX"; FAIL=1; }
    done
  done
  echo "chr$C done"
done
echo "excluded-marker scoring finished $(date) (fail=$FAIL)"
exit $FAIL
