#!/bin/bash
#SBATCH --job-name=rev2_bench_chip_bgl
#SBATCH --output=logs/%x_%A_%a.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=06:00:00
#SBATCH --array=0-21

# Score Beagle's array-to-WGS output on the same marker set and with the same scoring
# rules as the BiU-Net arms.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh

DS=${1:?usage: sbatch job/rev2_bench_chip_beagle.batch DATASET}
C=$((SLURM_ARRAY_TASK_ID + 1))
export MPLBACKEND=Agg

CSV=$REMOTE_ROOT/beagle/impute/2000/90%/${DS}_chr${C}_ALL_missing90%_imputed.csv.gz
[ -s "$CSV" ] || { echo "no Beagle output yet for $DS chr$C"; exit 1; }

"$PYBIN" -u benchmark.py --configFile "configs/test_${DS}_chrft_chip_${C}.yaml" \
    --impMethod beagle
RC=$?
echo "done $DS chr$C rc=$RC"
exit $RC
