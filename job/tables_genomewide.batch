#!/bin/bash
#SBATCH --job-name=tables_genomewide
#SBATCH --output=logs/%x_%j.log
#SBATCH --open-mode=append
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00

# Project root + central credentials (REMOTE_*, PYBIN, MASTER_PORT, NCCL_*, etc.).
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=8
unset SLURM_TRES_PER_TASK

# Every genome-wide table, rendered from the benchmark cells in analysis/.
mkdir -p Results
for DS in 1KGP SGDP; do
  "$PYBIN" -u scripts/build_per_chromosome_tables.py "$DS"        # per-chromosome and genome-wide
  "$PYBIN" -u scripts/build_main_tables.py "$DS"   # the collapsed main table
done
"$PYBIN" -u scripts/build_finetuning_tables.py                 # genome-wide model vs fine-tuned
"$PYBIN" -u scripts/build_ablation_tables.py                # reference ablation, per-bin anchors
"$PYBIN" -u scripts/build_excluded_recovery_table.py           # markers Beagle cannot call
# Reads the submitted supplementary DOCX for the region-specific values; give it that
# file, or drop this line if the comparison is not being rebuilt.
"$PYBIN" -u scripts/build_genomewide_vs_region_tables.py         # against the region-specific models
echo "tables -> Results/"
