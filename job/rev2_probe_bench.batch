#!/bin/bash
#SBATCH --job-name=rev2_probe_bench
#SBATCH --output=logs/%x_%A_%a.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=0
#SBATCH --time=08:00:00
#SBATCH --array=0-1

# Scores an already-imputed mid-run probe.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export HDF5_USE_FILE_LOCKING=FALSE

CHRS=(22 1)
C=${CHRS[$SLURM_ARRAY_TASK_ID]}
EP=${EP:-70}
CFG=configs/test_v3low_ref_g22_chr${C}_e${EP}.yaml

FAIL=0
for RS in 0 42 1024; do
  for IDX in 0 1 2; do
    echo "== chr$C epoch$EP benchmark: rand=$RS missingIdx=$IDX"
    "$PYBIN" -u benchmark.py --configFile "$CFG" --randState "$RS" --missingLevelIdx "$IDX" || FAIL=1
  done
done
echo "== chr$C epoch$EP scored $(date) (fail=$FAIL)"
exit $FAIL
