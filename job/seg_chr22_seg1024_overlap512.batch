#!/bin/bash
#SBATCH --output=logs/seg_chr22_seg1024_ov512_%j.log
#SBATCH --time=12:00:00
#SBATCH --job-name=seg_ov512
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=20

source configs/credentials.sh
export OMP_NUM_THREADS=1
unset SLURM_TRES_PER_TASK

cd "${SLURM_SUBMIT_DIR:-.}"
srun python -u segmenting.py --configFile configs/1KGP_chr22_ALL_seg1024_overlap512.yaml --createFilteredSNPs False
