#!/bin/bash
#SBATCH --output=logs/test_1kgp_50pct_rand42_%j.log
#SBATCH --time=2-00:00:00
#SBATCH --job-name=biunet_test_1kgp
#SBATCH --partition=gpu2
#SBATCH --nodes=4
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=30
#SBATCH --gpus-per-task=1
#SBATCH --gres=gpu:2
#SBATCH --exclusive

# BiUNet inference at 50% rand=42 for 1KGP_chr22_ALL.

source configs/credentials.sh
export DDP_BACKEND=gloo

export WORLD_SIZE=$SLURM_NTASKS
export RANK=$SLURM_PROCID

MASTER_NODE=$(scontrol show hostnames $SLURM_JOB_NODELIST | head -n 1)
MASTER_ADDR=$(srun --nodes=1 --ntasks=1 -w $MASTER_NODE hostname --ip-address | tail -n 1)
MASTER_PORT=$(( 10000 + $(($SLURM_JOB_ID % 50000)) ))
export MASTER_ADDR=$MASTER_ADDR
export MASTER_PORT=$MASTER_PORT

CONFIG_FILE="configs/test_1KGP_chr22_ALL_seg128_overlap16_50pct_rand42.yaml"

start=$(date +%s)
echo "Job $SLURM_JOB_ID started at $(date) on $SLURM_JOB_NODELIST (WORLD_SIZE=$WORLD_SIZE)"
srun --export=ALL python -u test.py --configFile $CONFIG_FILE
end=$(date +%s)
elapsed=$((end - start))
echo "Job $SLURM_JOB_ID finished at $(date), elapsed: $((elapsed / 60))m $((elapsed % 60))s"
