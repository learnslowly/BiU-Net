#!/bin/bash
#SBATCH --output=logs/rev2_train_scda_sgdp_scratch_%j.log
#SBATCH --open-mode=append
#SBATCH --time=1-12:00:00
#SBATCH --job-name=rev2_scda_scr
#SBATCH --partition=gpu4
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=16
#SBATCH --gpus-per-task=1

# Revision-2 SGDP experiment, standalone: SCDA baseline trained from random
# initialisation on SGDP's own training split merged with the L1-aligned full 1KGP
# panel.

cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=1

export MASTER_ADDR=$(scontrol show hostname $SLURM_NODELIST | head -n 1)
export MASTER_PORT=12391
export NCCL_DEBUG=WARN
export NCCL_IB_DISABLE=0
export NCCL_SOCKET_IFNAME=^lo
export TRITON_CACHE_DIR=/tmp/$USER/triton_cache_$SLURM_JOB_ID
export TORCHINDUCTOR_CACHE_DIR=/tmp/$USER/inductor_cache_$SLURM_JOB_ID
mkdir -p $TRITON_CACHE_DIR $TORCHINDUCTOR_CACHE_DIR
# full-length activations are large; the allocator fragments without this
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

CONFIG_FILE="configs/train_SGDP_g22_ALL_seg-1_scda_scratch.yaml"

echo "Job $SLURM_JOB_ID started at $(date) on $SLURM_JOB_NODELIST"
# 8 ranks on gpu4, the largest allocation this account can actually get soon (a 24-GPU
# gpu2 allocation would not start for another day).
srun --export=ALL --gpu-bind=closest "$PYBIN" -u train.py --configFile $CONFIG_FILE
RC=$?
echo "Job $SLURM_JOB_ID finished at $(date) (srun rc=$RC)"
exit $RC
