#!/bin/bash
#SBATCH --job-name=rev2_chip_rescore_bu
#SBATCH --output=logs/%x_%A_%a.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=06:00:00
#SBATCH --array=0-21

# Re-score a BiU-Net arm on the marker set Beagle retained.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh

TAG=${1:?usage: sbatch job/rev2_chip_rescore_biunet.batch TAG DATASET}
DS=${2:?usage: sbatch job/rev2_chip_rescore_biunet.batch TAG DATASET}
C=$((SLURM_ARRAY_TASK_ID + 1))
export MPLBACKEND=Agg

if [ "$TAG" = "chipft" ]; then
  CFG="configs/test_${DS}_chipft_${C}.yaml"
else
  CFG="configs/test_${DS}_chrft_chip_${C}.yaml"
fi
[ -s "$CFG" ] || { echo "missing $CFG"; exit 1; }

OVL="analysis/Beagle_overlapped_loci_rand2000_${DS}_chr${C}_missing90%.txt"
[ -s "$OVL" ] || { echo "no overlap list yet for $DS chr$C, score Beagle first"; exit 1; }

"$PYBIN" -u benchmark.py --configFile "$CFG"
RC=$?
echo "done $DS chr$C tag=$TAG rc=$RC"
exit $RC
