#!/bin/bash
#SBATCH --output=./logs/seg_sgdp_chr19_%j.log
#SBATCH --open-mode=append
#SBATCH --time=1-00:00:00
#SBATCH --job-name=seg_sgdp_chr19
#SBATCH --partition=workq
#SBATCH --nodes=4
#SBATCH --ntasks=4
#SBATCH --cpus-per-task=16

# Activate the environment
source configs/credentials.sh
export OMP_NUM_THREADS=1
export HDF5_USE_FILE_LOCKING=FALSE
unset SLURM_TRES_PER_TASK

CONF=configs/seg_SGDP_chr19_ALL_seg128_overlap16.yaml

# Call u19's interpreter by ABSOLUTE PATH -- `conda activate` does not reliably take
# effect inside batch jobs on this cluster (see 02_vcf2csv.batch).

# --createFilteredSNPs False: skip the per-MAF-bin filtered-HDF5 generation that OOM-
# killed the colwise smoke run.
echo "Start: $(date)"
srun "${PYBIN}" -u segmenting.py --configFile ${CONF} --createFilteredSNPs False
echo "End:   $(date)"
