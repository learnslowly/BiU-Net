#!/bin/bash
#SBATCH --job-name=rev2_chrft_blk
#SBATCH --output=logs/%x_%j.log
#SBATCH --partition=gpu4
#SBATCH --nodes=4
#SBATCH --ntasks=16
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=12
#SBATCH --gpus-per-task=1
#SBATCH --time=3-00:00:00

# Per-chromosome fine-tuning held inside ONE allocation, one chromosome per node,
# refilled as steps finish. Usage: sbatch job/rev2_train_chrft_block.batch SGDP sbatch
# job/rev2_train_chrft_block.batch SGDP 1KGP A chromosome whose final checkpoint already
# exists is skipped, so this can run alongside, or after, the gpu2 arrays covering the
# same work without repeating any of it.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh

[ $# -ge 1 ] || { echo "usage: sbatch job/rev2_train_chrft_block.batch DATASET [DATASET...]"; exit 2; }
NODES=${SLURM_JOB_NUM_NODES:-4}
PER_NODE=${SLURM_NTASKS_PER_NODE:-4}
SEG=seg1024_overlap128

runid_of()  { case "$1" in 1KGP) echo v3low_ftchr;;   SGDP) echo ft_sgdp_ftchr;; esac; }
srcrun_of() { case "$1" in 1KGP) echo v3low_ref_g22;; SGDP) echo ft_sgdp_full;;  esac; }
srcep_of()  { case "$1" in 1KGP) echo 70;;            SGDP) echo best;;          esac; }
# The reporting checkpoint: 1KGP runs a fixed schedule with val folded into training,
# SGDP holds val out and selects on it.
final_of()  { case "$1" in 1KGP) echo 30;;            SGDP) echo best;;          esac; }

# Largest chromosomes first: the makespan of a refilling pool is set by whether the long
# jobs start early.
ORDER=(1 2 3 6 4 5 7 8 11 10 12 9 17 16 19 15 14 22 20 18 13 21)

# CHRFT_SKIP lists work another runner already owns, as "1KGP:9 1KGP:10".
SKIP=" ${CHRFT_SKIP:-} "

done_already() {
  local DS=$1 C=$2 RUNID FIN
  RUNID=$(runid_of "$DS"); FIN=$(final_of "$DS")
  [ -s "checkpoints/checkpoint_${RUNID}_${DS}_chr${C}_ALL_${SEG}_epoch_${FIN}.pth" ]
}

WORK=()
for DS in "$@"; do
  [ -n "$(runid_of "$DS")" ] || { echo "unknown dataset: $DS"; exit 2; }
  for C in "${ORDER[@]}"; do
    if [[ "$SKIP" == *" $DS:$C "* ]]; then
      echo "skip $DS chr$C: claimed by another job"
      continue
    fi
    if done_already "$DS" "$C"; then
      echo "skip $DS chr$C: already trained"
      continue
    fi
    WORK+=("$DS:$C")
  done
done

echo "allocation: $NODES nodes ($PER_NODE GPUs each), $SLURM_JOB_NODELIST"
echo "queue: ${#WORK[@]} chromosomes, up to $NODES at a time"
echo "start $(date)"
[ ${#WORK[@]} -eq 0 ] && { echo "nothing to do"; exit 0; }

# Settle the step GPU request once, inside the allocation, rather than guessing.
STEP_GPU="--gpus-per-task=1"
if ! srun --exclusive --nodes=1 --ntasks="$PER_NODE" --cpus-per-task=12 \
          $STEP_GPU --gpu-bind=closest true 2>/dev/null; then
  STEP_GPU="--gres=gpu:$PER_NODE"
  echo "step GPU request falls back to $STEP_GPU"
fi
echo "step GPU request: $STEP_GPU"

prebake() {
  local DS=$1 C=$2
  local RUNID SRC SRCEP DST
  RUNID=$(runid_of "$DS"); SRC=$(srcrun_of "$DS"); SRCEP=$(srcep_of "$DS")
  DST="checkpoints/checkpoint_${RUNID}_${DS}_chr${C}_ALL_${SEG}_epoch_0.pth"
  ls "checkpoints/checkpoint_${RUNID}_${DS}_chr${C}_ALL_${SEG}_epoch_"*.pth >/dev/null 2>&1 && return 0
  local SRCF="checkpoints/checkpoint_${SRC}_${DS}_chr${C}_ALL_${SEG}_epoch_${SRCEP}.pth"
  [ -s "$SRCF" ] || { echo "ERROR: source checkpoint missing: $SRCF"; return 1; }
  "$PYBIN" - "$SRCF" "$DST" <<'EOF'
import sys, torch
src, dst = sys.argv[1], sys.argv[2]
ck = torch.load(src, map_location='cpu', weights_only=False)
ck['epoch'] = 0
ck.pop('optimizer', None)
ck.pop('scheduler', None)
torch.save(ck, dst)
EOF
  [ -s "$DST" ] || { echo "ERROR: prebake produced nothing for $DS chr$C"; return 1; }
  echo "prebaked $DS chr$C"
}

# A counting pool: the cluster runs bash 4.4, whose `wait -n` gives an exit status but
# not the child it came from.
FAIL=0
nrun=0
slot=0

reap() {
  wait -n
  local rc=$?
  nrun=$((nrun - 1))
  [ $rc -ne 0 ] && { echo "a step exited rc=$rc"; FAIL=1; }
  return 0
}

for item in "${WORK[@]}"; do
  while [ $nrun -ge "$NODES" ]; do reap; done
  DS="${item%%:*}"; C="${item##*:}"
  # Re-check at dispatch: another runner may have finished this chromosome in
  # the time this job spent working through the queue.
  if done_already "$DS" "$C"; then
    echo "skip $DS chr$C: finished elsewhere while queued"
    continue
  fi
  if ! prebake "$DS" "$C"; then
    FAIL=1
    continue
  fi
  srun --exclusive --nodes=1 --ntasks="$PER_NODE" --cpus-per-task=12 \
       $STEP_GPU --gpu-bind=closest \
       --export=ALL,FT_DS="$DS",FT_C="$C",FT_PORT=$((15000 + slot)) \
       bash scripts/train_one_chr.sh &
  nrun=$((nrun + 1))
  slot=$(((slot + 1) % 200))
  echo "dispatched $DS chr$C (running $nrun)"
done

while [ $nrun -gt 0 ]; do reap; done

echo "all fine-tuning finished $(date) (fail=$FAIL)"
exit $FAIL
