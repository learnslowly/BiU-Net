#!/bin/bash
#SBATCH --job-name=rev2_chipmask
#SBATCH --output=logs/%x_%A_%a.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=20
#SBATCH --time=12:00:00
#SBATCH --array=0-21

# Array-to-WGS test sets: one chromosome per array task, for the dataset named on the
# command line.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh

DS=${1:?usage: sbatch job/rev2_chip_mask.batch DATASET}
C=$((SLURM_ARRAY_TASK_ID + 1))

export PATH=$HOME/local/bin:$PATH          # bcftools, tabix
export LD_LIBRARY_PATH=$HOME/local/lib:$LD_LIBRARY_PATH
which bcftools tabix || { echo "ERROR: bcftools/tabix not on PATH"; exit 1; }

echo "chip mask: $DS chr$C  (job $SLURM_JOB_ID task $SLURM_ARRAY_TASK_ID)"
start=$(date +%s)
M=data/$DS/masked/2000/90%
if [ -s "$M/${DS}_chr${C}_ALL_missing90%_masked.csv.gz" ] && \
   [ -s "$M/${DS}_chr${C}_ALL_missing90%_target.vcf.gz" ]; then
  echo "mask already built, going straight to segmenting"
else
  "$PYBIN" -u scripts/masking_chip_gw.py \
      --dataset "$DS" --chromosome "$C" --population ALL \
      --observed-fraction 0.10 --maf-min 0.05 --rand-state 2000
  RC=$?
  [ $RC -ne 0 ] && { echo "masking failed rc=$RC"; exit $RC; }
  echo "masking done in $(( ($(date +%s)-start)/60 ))m"
fi

# Segment the masked grid into the HDF5 the test step reads.
export OMP_NUM_THREADS=1
unset SLURM_TRES_PER_TASK
seg_start=$(date +%s)
"$PYBIN" -u segmenting.py --configFile "configs/test_${DS}_chipft_${C}.yaml" \
    --createFilteredSNPs False
RC=$?
echo "segmenting rc=$RC, $(( ($(date +%s)-seg_start)/60 ))m"
echo "total $(( ($(date +%s)-start)/60 ))m"
exit $RC
