#!/bin/bash
#SBATCH --job-name=rev2_cond_check
#SBATCH --output=logs/%x_%j.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=04:00:00

# Does the documented join condition account for every missing marker, or is something
# else dropping records as well? The condition keeps a target marker when the panel
# holds a record with the same chromosome, position and allele list.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
$PYBIN - <<'PY'
import gzip
import numpy as np, pandas as pd

DATA = "$GENOTYPE_DATA_DIR"
CHROM = 19

def records(path):
    """{pos: set of (ref, alt-tuple)} exactly as Marker.equals would compare."""
    out = {}
    op = gzip.open if path.endswith(".gz") else open
    with op(path, "rt") as f:
        for line in f:
            if line[0] == "#":
                continue
            p = line.split("\t", 6)
            out.setdefault(int(p[1]), set()).add((p[3], tuple(p[4].split(","))))
    return out

targ_vcf = f"{DATA}/SGDP/masked/0/5%/SGDP_chr{CHROM}_ALL_missing5%_masked.vcf.gz"
ref_vcf = f"{DATA}/1KGP/ref/1KGP_chr{CHROM}_ALL_ref.vcf.gz"
print(f"target VCF: {targ_vcf}", flush=True)
targ = records(targ_vcf)
print(f"  {sum(len(v) for v in targ.values()):,} records at {len(targ):,} positions", flush=True)
ref = records(ref_vcf)
print(f"panel: {sum(len(v) for v in ref.values()):,} records at {len(ref):,} positions", flush=True)

predicted = {pos for pos, alls in targ.items()
             if pos in ref and (alls & ref[pos])}
actual = set(pd.read_csv(
    f"analysis/Beagle_overlapped_loci_rand0_SGDP_chr{CHROM}_missing5%.txt",
    sep="\t")["locus"].astype(int))

print(f"\npredicted retained by the condition : {len(predicted):,}")
print(f"actually retained by Beagle         : {len(actual):,}")
pa = predicted - actual
ap = actual - predicted
print(f"predicted but NOT retained          : {len(pa):,}")
print(f"retained but NOT predicted          : {len(ap):,}")
if pa:
    ex = sorted(pa)[:8]
    print(f"  examples of predicted-but-dropped: {ex}")
    for p in ex[:4]:
        print(f"    pos {p}: target {sorted(targ[p])}  panel {sorted(ref.get(p, []))}")
if ap:
    ex = sorted(ap)[:8]
    print(f"  examples of retained-but-unpredicted: {ex}")
    for p in ex[:4]:
        print(f"    pos {p}: target {sorted(targ.get(p, []))}  panel {sorted(ref.get(p, []))}")
PY
