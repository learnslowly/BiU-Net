#!/bin/bash
#SBATCH --job-name=rev2_seg_wide
#SBATCH --output=logs/%x_%j.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=20
#SBATCH --time=08:00:00

# Segment 1KGP chromosome 22 at 4,096 markers per window, overlapping by 512: training
# and validation splits for the wide-window run, and the array test set it will be
# scored on.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh

export OMP_NUM_THREADS=1
unset SLURM_TRES_PER_TASK

start=$(date +%s)
"$PYBIN" -u segmenting.py --configFile configs/test_1KGP_chipscratch4096_22.yaml \
    --createFilteredSNPs False
RC=$?
echo "segmenting rc=$RC, $(( ($(date +%s)-start)/60 ))m"
ls -la res/ | grep "1KGP_chr22.*seg4096" | head
exit $RC
