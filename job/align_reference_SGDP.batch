#!/bin/bash
#SBATCH --job-name=align_reference_SGDP
#SBATCH --output=logs/%x_%j.log
#SBATCH --open-mode=append
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=192G
#SBATCH --time=1-00:00:00

# Project root + central credentials (REMOTE_*, PYBIN, MASTER_PORT, NCCL_*, etc.).
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=8
unset SLURM_TRES_PER_TASK

# Reindex the 1KGP reference panel onto the SGDP variant axis, one chromosome at a time:
# shared positions take the reference genotype, target-private positions are marked
# missing for those samples, reference-private positions are dropped.
"$PYBIN" -u scripts/align_ref_to_sgdp.py full
echo "reference projected onto the SGDP axis"
