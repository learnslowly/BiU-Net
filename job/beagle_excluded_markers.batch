#!/bin/bash
#SBATCH --job-name=beagle_excluded_markers
#SBATCH --output=logs/%x_%j.log
#SBATCH --open-mode=append
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=192G
#SBATCH --time=1-00:00:00

# Project root + central credentials (REMOTE_*, PYBIN, MASTER_PORT, NCCL_*, etc.).
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=8
unset SLURM_TRES_PER_TASK

# Which target markers Beagle cannot match against its panel, per chromosome and
# frequency band, by reproducing its match condition from the two VCF files.
for DS in SGDP 1KGP; do
  echo "===== $DS ====="
  "$PYBIN" -u scripts/beagle_excluded_markers.py "$DS" $(seq 1 22)
done
echo "exclusion counts -> Results/beagle_excluded_markers_*.csv"
