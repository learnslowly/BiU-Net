#!/bin/bash
#SBATCH --job-name=rev2_chip_evalblk
#SBATCH --output=logs/%x_%j.log
#SBATCH --partition=gpu4
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=12
#SBATCH --gpus-per-task=1
#SBATCH --time=3-00:00:00

# Evaluates the array-to-WGS test set inside ONE allocation.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"

NODES=${SLURM_JOB_NUM_NODES:-12}
# One task per GPU on the node.
PER_NODE=${SLURM_NTASKS_PER_NODE:-2}
TAG=${1:?usage: sbatch job/rev2_eval_chip_block.batch TAG DATASET [DATASET...]}
shift
[ $# -ge 1 ] || { echo "no dataset given"; exit 2; }
# Anchors first, as in the training block: chromosome 22 on 1KGP and 19 on SGDP are the
# two the original submission reports.
ORDER=(${CHIP_EVAL_ORDER:-22 19 1 2 3 6 4 5 7 8 11 10 12 9 17 16 15 14 20 18 13 21})
WORK=()
for DS in "$@"; do
  for C in "${ORDER[@]}"; do
    WORK+=("$DS:$C")
  done
done

echo "allocation: $NODES nodes x $PER_NODE GPUs, $SLURM_JOB_NODELIST"
echo "queue: ${#WORK[@]} chromosome evaluations, up to $NODES at a time"
echo "start $(date)"

# Slurm accepts either --gpus-per-task or --gres on a step, but not always the form that
# differs from the job's own request.
STEP_GPU="--gpus-per-task=1"
if ! srun --exclusive --nodes=1 --ntasks="$PER_NODE" --cpus-per-task=12 $STEP_GPU --gpu-bind=closest true 2>/dev/null; then
  STEP_GPU="--gres=gpu:$PER_NODE"
  echo "step GPU request falls back to $STEP_GPU"
fi
echo "step GPU request: $STEP_GPU"

# A counting pool rather than a pid map: the cluster runs bash 4.4, whose `wait -n`
# reports an exit status but cannot report which child it belonged to (`wait -n -p`
# needs 5.1).
FAIL=0
nrun=0
slot=0

reap() {
  wait -n
  local rc=$?
  nrun=$((nrun - 1))
  [ $rc -ne 0 ] && { echo "a step exited rc=$rc (see its own line above)"; FAIL=1; }
  return 0
}

for item in "${WORK[@]}"; do
  while [ $nrun -ge "$NODES" ]; do reap; done
  DS="${item%%:*}"; C="${item##*:}"
  srun --exclusive --nodes=1 --ntasks="$PER_NODE" --cpus-per-task=12 $STEP_GPU --gpu-bind=closest \
       --export=ALL,EVAL_DS="$DS",EVAL_C="$C",EVAL_TAG="$TAG",EVAL_PORT=$((17000 + slot)) \
       bash scripts/eval_one_chr_chip.sh &
  nrun=$((nrun + 1))
  slot=$(((slot + 1) % 200))
  echo "dispatched $DS chr$C (running $nrun)"
done

while [ $nrun -gt 0 ]; do reap; done

echo "all evaluations finished $(date) (fail=$FAIL)"
exit $FAIL
