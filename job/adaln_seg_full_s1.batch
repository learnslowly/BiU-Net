#!/bin/bash
#SBATCH --job-name=adaln_seg_full_s1
#SBATCH --output=logs/%x_%A_%a.log
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=10:00:00
#SBATCH --array=1-22
# seg-1 full-length ALLPANEL HDF5s (aligned 2548-sample panel on the SGDP axis) for the
# SCDA finetune; train chunk only.
set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
C=$SLURM_ARRAY_TASK_ID
export OMP_NUM_THREADS=1
export HDF5_USE_FILE_LOCKING=FALSE
unset SLURM_TRES_PER_TASK
srun "$PYBIN" -u segmenting.py --configFile configs/seg_SGDP_chr${C}_ALLPANEL_seg-1.yaml --createFilteredSNPs False
RC=$?
echo "End chr$C (rc=$RC)"
exit $RC
