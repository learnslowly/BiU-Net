#!/bin/bash
#SBATCH --job-name=rev2_chrft
#SBATCH --output=logs/%x_%A_%a.log
#SBATCH --partition=gpu2
#SBATCH --nodes=2
#SBATCH --ntasks=4
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=24
#SBATCH --gpus-per-task=1
#SBATCH --time=06:00:00
#SBATCH --array=0-21

# Per-chromosome fine-tuning of the genome-wide merged-data model.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
DS="${1:-}"
[ -n "$DS" ] || { echo "usage: sbatch job/rev2_train_chrft.batch 1KGP|SGDP"; exit 2; }

case "$DS" in
  1KGP) RUNID=v3low_ftchr;    SRC_RUN=v3low_ref_g22;  SRC_EPOCH=70 ;;
  SGDP) RUNID=ft_sgdp_ftchr;  SRC_RUN=ft_sgdp_full;   SRC_EPOCH=best ;;
  *) echo "unknown dataset: $DS"; exit 2 ;;
esac

ORDER=(1 2 3 6 4 5 7 8 11 10 12 9 17 16 19 15 14 22 20 18 13 21)
C="${ORDER[$SLURM_ARRAY_TASK_ID]}"

export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=1
export MASTER_ADDR=$(scontrol show hostname "$SLURM_JOB_NODELIST" | head -n 1)
export MASTER_PORT=$((13000 + SLURM_ARRAY_TASK_ID))
export NCCL_DEBUG=WARN
export NCCL_IB_DISABLE=0
export NCCL_SOCKET_IFNAME=^lo
export TRITON_CACHE_DIR=/tmp/$USER/triton_${SLURM_JOB_ID}
export TORCHINDUCTOR_CACHE_DIR=/tmp/$USER/inductor_${SLURM_JOB_ID}
mkdir -p "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR"

CFG="configs/train_${DS}_chrft_${C}.yaml"
TAG="${DS}_chr${C}_ALL_seg1024_overlap128"
SRC="checkpoints/checkpoint_${SRC_RUN}_${TAG}_epoch_${SRC_EPOCH}.pth"
DST="checkpoints/checkpoint_${RUNID}_${TAG}_epoch_0.pth"

[ -s "$CFG" ] || { echo "ERROR: missing config $CFG"; exit 1; }

# Prebake only when no checkpoint of this run exists for this chromosome, so a requeued
# task resumes its own progress instead of restarting from the source.
if ! ls "checkpoints/checkpoint_${RUNID}_${TAG}_epoch_"*.pth >/dev/null 2>&1; then
  [ -s "$SRC" ] || { echo "ERROR: source checkpoint missing: $SRC"; exit 1; }
  echo "Prebaking $DST from $SRC"
  "$PYBIN" - "$SRC" "$DST" <<'EOF'
import sys, torch
src, dst = sys.argv[1], sys.argv[2]
ck = torch.load(src, map_location='cpu', weights_only=False)
ck['epoch'] = 0
ck.pop('optimizer', None)
ck.pop('scheduler', None)
torch.save(ck, dst)
print(f"prebaked: {dst}")
EOF
  [ -s "$DST" ] || { echo "ERROR: prebake produced nothing"; exit 1; }
fi

echo "task $SLURM_ARRAY_TASK_ID -> $DS chr$C  job $SLURM_JOB_ID on $SLURM_JOB_NODELIST  start $(date)"
srun --export=ALL --gpu-bind=closest "$PYBIN" -u train.py --configFile "$CFG"
RC=$?
echo "task $SLURM_ARRAY_TASK_ID ($DS chr$C) finished $(date) rc=$RC"
exit $RC
