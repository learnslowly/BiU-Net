#!/bin/bash
#SBATCH --output=logs/mask_colwise_LOS_ALL_rand0_%j.log
#SBATCH --time=00:40:00
#SBATCH --job-name=mask_cw_r0
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4

# Colwise masks at random_state 0 (seed 0, label 0) for ALL rates 5/15/25/50/95%. Writes
# BiUNet/data/LOS/masked/0/{5,15,25,50,95}%/.

source configs/credentials.sh
echo "Job $SLURM_JOB_ID started at $(date)"
which bcftools tabix || { echo "ERROR: bcftools/tabix not on PATH"; exit 1; }
start=$(date +%s)

srun python -u $GENOTYPE_DATA_DIR/masking_colwise.py \
    --dataset LOS --chromosome 22 --population ALL \
    --seed 0 --rand-state 0 \
    --missing-ratios 0.05 0.15 0.25 0.5 0.95

rc=$?; end=$(date +%s)
echo "masking_colwise.py exited with $rc"
echo "Elapsed: $(( (end-start)/60 ))m $(( (end-start)%60 ))s"
for p in 5 15 25 50 95; do echo "--- ${p}% ---"; ls data/LOS/masked/0/${p}%/ 2>&1; done
exit $rc
