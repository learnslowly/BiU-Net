#!/bin/bash
#SBATCH --output=logs/%x_%A_%a.log
#SBATCH --time=08:00:00
#SBATCH --job-name=rev2_cache_seg1
#SBATCH --partition=workq
#SBATCH --array=1-22
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=0

# Build the factorized preload caches for the SGDP full-length (seg-1) data the SCDA
# baseline trains on: its own train/val split plus the L1-aligned reference panel.

cd "${SLURM_SUBMIT_DIR:-.}"
source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
C=$SLURM_ARRAY_TASK_ID

echo "chr$C seg-1 cache build started $(date)"
"$PYBIN" -u scripts/build_compact_cache.py \
    "res/SGDP_chr${C}_ALL_train_chunk*_seg-1_overlap0.hdf5" \
    "res/SGDP_chr${C}_ALL_val_chunk*_seg-1_overlap0.hdf5" \
    "res/SGDP_chr${C}_ALLPANEL_train_chunk*_seg-1_overlap0.hdf5"
RC=$?
echo "chr$C seg-1 cache build finished $(date) (rc=$RC)"
exit $RC
