#!/bin/bash
#SBATCH --output=logs/test_colwise_LOS_ALL_25_%j.log
#SBATCH --time=02:00:00
#SBATCH --job-name=test_cw_los25
#SBATCH --partition=gpu4
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=12
#SBATCH --gpus-per-task=1
#SBATCH --gres=gpu:1

# Column-wise smoke, step 2/3: BiUNet inference on the colwise-masked test set
# (rand_state 1042, missing 25%, v3_low_seg128 ep210), then phased BAT+PV benchmark.

source configs/credentials.sh
export HDF5_USE_FILE_LOCKING=FALSE
export MASTER_ADDR=$(scontrol show hostname $SLURM_NODELIST | head -n 1)
export MASTER_PORT=12351
export NCCL_DEBUG=WARN
export TRITON_CACHE_DIR=/tmp/$USER/triton_cache
mkdir -p $TRITON_CACHE_DIR

cd "${SLURM_SUBMIT_DIR:-.}"
CONFIG_FILE="configs/test_v3low_seg128_LOS_chr22_ALL_25_colwise.yaml"
start=$(date +%s)
echo "Job $SLURM_JOB_ID started at $(date)"

# BiUNet inference -> writes ./impute/1042/25%/..._imputed.csv.gz (+ _dosage variants)
srun --export=ALL --gpu-bind=closest python -u test.py --configFile $CONFIG_FILE
echo "test.py exited with $?"

# Phased per-variant (PV) benchmark on all positions (BAT).
python -u benchmark.py --configFile $CONFIG_FILE --randState 1042 --missingLevelIdx 0
echo "benchmark exited with $?"

end=$(date +%s)
echo "Elapsed: $(( (end-start)/60 ))m $(( (end-start)%60 ))s"
