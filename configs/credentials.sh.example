#!/usr/bin/env bash
# ============================================================================
# TEMPLATE for configs/credentials.sh — copy to credentials.sh and fill in.
#   cp configs/credentials.sh.example configs/credentials.sh
# credentials.sh is .gitignored (carries the WandB key); this template is committed.
# Consumed by job/*.batch, submit.sh and modelconfig.py).
# ============================================================================

# --- Cluster / SSH ---
export REMOTE_USER="your_user"
export REMOTE_HOST="login.your-cluster.edu"
export REMOTE_SSH="${REMOTE_USER}@${REMOTE_HOST}"
export REMOTE_ROOT="/work/${REMOTE_USER}/proj"
export PROJECT="BiUNet"
export REMOTE_DIR="${REMOTE_ROOT}/${PROJECT}"

# --- Data ---
# Root of the genotype cohort trees (1KGP/, SGDP/, LOS/). Read by the data-prep
# and reference-alignment scripts, which hold no site paths of their own.
export GENOTYPE_DATA_DIR="${REMOTE_ROOT}/data"

# --- SLURM ---
export SLURM_ACCOUNT="your_slurm_account"
export NOTIFY_EMAIL="${REMOTE_USER}@your-cluster.edu"
export PART_CPU="workq"
export PART_GPU2="gpu2"
export PART_GPU4="gpu4"

# --- Conda / Python ---
export CONDA_BASE="/work/${REMOTE_USER}/miniconda3"
export CONDA_ENV="your_env"
export PYBIN="${CONDA_BASE}/envs/${CONDA_ENV}/bin/python3.10"

# --- DDP / NCCL ---
export MASTER_PORT="12340"
export NCCL_SOCKET_IFNAME="^lo"

# --- Secrets / data ---
export WANDB_API_KEY="your_wandb_api_key"
export BIO_FILE="${REMOTE_ROOT}/data/bio/chr22_bio.npz"
